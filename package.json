{
  "name": "egofocus",
  "version": "0.0.0",
  "private": true,
  "description": "Локальный прототип EgoFocus",
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "scripts": {
    "deps:check": "expo install --check",
    "doctor": "expo-doctor",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "start": "expo start --dev-client",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "build:web": "expo export --platform web",
    "test": "node --experimental-strip-types --test tests/*.test.mjs"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.17",
    "@expo/ui": "~58.0.27",
    "@noble/hashes": "^2.4.0",
    "expo": "58.0.23",
    "expo-asset": "~58.0.20",
    "expo-constants": "~58.0.15",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.18",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-glass-effect": "~58.0.5",
    "expo-haptics": "~58.0.7",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.16",
    "expo-sharing": "~58.0.22",
    "expo-splash-screen": "~58.0.13",
    "expo-sqlite": "~58.0.15",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-widgets": "~58.0.27",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "expo-doctor": "1.21.6",
    "prettier": "3.9.10",
    "typescript": "~6.0.3"
  },
  "main": "index.ts"
}
